{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM"],
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"types": ["vitest", "node"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"erasableSyntaxOnly": true,
	"include": [
		"src",
		"vitest.config.ts",
		"vitest.setup.ts",
		"tsdown.config.ts",
		"../grimoire-cli/src/handlers/flows/modifiers/ctorEdit/edi../grimoire-cli/src/handlers/flows/modifiers/ctorEdit/edit.tsutils/edit.ts",
		"../grimoire-cli/src/handlers/flows/modifiers/ctorFilter/filterValues.test.ts",
		"../grimoire-cli/src/handlers/flows/modifiers/ctorFilter/filterValues.ts"
	]
}
