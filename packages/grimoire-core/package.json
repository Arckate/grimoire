{
	"name": "@arckate/grimoire-core",
	"type": "module",
	"version": "0.0.1",
	"description": "Core engine for Grimoire — pluggable generator runners, workflow orchestration, and file generation primitives",
	"main": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"author": {
		"name": "Emeric Lebbrecht",
		"email": "emeric.lebbrecht@gmail.com"
	},
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"publish": "pnpm publish --tag latest --access public"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./utils": {
			"import": "./dist/utils/index.mjs",
			"types": "./dist/utils/index.d.mts"
		},
		"./components": {
			"import": "./dist/prompts/components/index.mjs",
			"types": "./dist/prompts/components/index.d.mts"
		},
		"./prompts": {
			"import": "./dist/prompts/index.mjs",
			"types": "./dist/prompts/index.d.mts"
		},
		"./path": {
			"import": "./dist/path/index.mjs",
			"types": "./dist/path/index.d.mts"
		},
		"./errors": {
			"import": "./dist/errors/index.mjs",
			"types": "./dist/errors/index.d.mts"
		},
		"./models": {
			"import": "./dist/models/index.mjs",
			"types": "./dist/models/index.d.mts"
		},
		"./const": {
			"import": "./dist/const/index.mjs",
			"types": "./dist/const/index.d.mts"
		},
		"./config": {
			"import": "./dist/config/index.mjs",
			"types": "./dist/config/index.d.mts"
		},
		"./handler": {
			"import": "./dist/handler/index.mjs",
			"types": "./dist/handler/index.d.mts"
		}
	},
	"typesVersions": {
		"*": {
			"config": [
				"dist/config/index.d.mts"
			],
			"utils": [
				"dist/utils/index.d.mts"
			],
			"components": [
				"dist/prompts/components/index.d.mts"
			],
			"prompts": [
				"dist/prompts/index.d.mts"
			],
			"path": [
				"dist/path/index.d.mts"
			],
			"errors": [
				"dist/errors/index.d.mts"
			],
			"models": [
				"dist/models/index.d.mts"
			],
			"const": [
				"dist/const/index.d.mts"
			],
			"handler": [
				"dist/handler/index.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@inquirer/prompts": "^8.2.0",
		"@types/lodash.merge": "^4.6.9",
		"@types/lodash.mergewith": "^4.6.9",
		"chalk": "^5.6.2",
		"commander": "^14.0.2",
		"ink": "^7.0.1",
		"ink-select-input": "^6.2.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^6.0.0",
		"lodash.merge": "^4.6.2",
		"lodash.mergewith": "^4.6.2",
		"node-plop": "^0.32.3",
		"ora": "^9.0.0",
		"react": "^19.2.3"
	},
	"devDependencies": {
		"@arckate/testing-cli": "workspace:*",
		"@biomejs/biome": "2.3.11",
		"@types/node": "^25.0.8",
		"@types/react": "^19.2.14",
		"@vitest/coverage-v8": "^4.0.17",
		"tsdown": "^0.19.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17"
	},
	"turbo": {
		"tags": [
			"core"
		]
	}
}
